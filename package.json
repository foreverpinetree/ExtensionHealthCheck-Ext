{
  "name": "extension-health-check",
  "version": "1.0.0",
  "description": "ExtensionHealthCheck",
  "scripts": {
    "test:health": "node tests/health.test.cjs",
    "watch": "node utils/dev.js",
    "watch:edge": "cross-env NODE_ENV=development BROSWER=Edge node utils/dev.js",
    "start": "node utils/webserver.js",
    "build": "node utils/build.js",
    "build:edge": "cross-env NODE_ENV=production BROSWER=Edge node utils/build.js",
    "build-zip": "cross-env TYPE=zip npm run build && cross-env BROSWER=Chrome node utils/build-zip.js",
    "build-zip:pro": "cross-env TYPE=zip PRO=1 npm run build && cross-env BROSWER=Chrome PRO=1 node utils/build-zip.js",
    "build-zip:edge-local": "cross-env TYPE=zip LOCAL=1 npm run build:edge && cross-env BROSWER=Edge LOCAL=1 node utils/build-zip.js",
    "build-zip:edge": "cross-env TYPE=zip npm run build:edge && cross-env BROSWER=Edge node utils/build-zip.js",
    "build-zip:all": "node utils/create-dir.js && cross-env DIR=1 npm run build-zip && cross-env DIR=1 npm run build-zip:pro && cross-env DIR=1 npm run build-zip:edge && cross-env DIR=1 npm run build-zip:edge-local",
    "zip": "npm run build-zip:all"
  },
  "keywords": [
    "chrome",
    "vue",
    "webpack",
    "chrome-extension"
  ],
  "author": "Jeevan Lal",
  "license": "MIT",
  "dependencies": {
    "axios": "^0.24.0",
    "buefy": "^1.0.1",
    "bulma": "^0.9.4",
    "cheerio": "1.0.0-rc.10",
    "copy-webpack-plugin": "^6.4.1",
    "core-js": "^3.6.5",
    "cross-env": "^7.0.3",
    "daisyui": "^5.0.50",
    "dayjs": "^1.11.18",
    "html-to-pdfmake": "^2.5.36",
    "json2csv": "^5.0.6",
    "jsonpath": "^1.1.1",
    "mitt": "^3.0.1",
    "parse": "^3.3.1",
    "pdfmake": "^0.2.23",
    "slugify": "^1.6.6",
    "source-map-loader": "^3.0.0",
    "tailwindcss": "^3.4.1",
    "terser-webpack-plugin": "^4.2.3",
    "vue": "^3.5.18",
    "vue-router": "^4.0.0",
    "vue3-countdown": "^1.0.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.1/xlsx-0.20.1.tgz",
    "xmlhttprequest": "^1.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/preset-env": "^7.28.0",
    "@types/minimatch": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.18",
    "archiver": "^5.3.0",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^8.1.0",
    "buffer": "^6.0.3",
    "child_process": "^1.0.2",
    "clean-webpack-plugin": "^3.0.0",
    "css-loader": "^5.2.7",
    "file-loader": "^6.1.0",
    "fs": "^0.0.1-security",
    "html-webpack-plugin": "^4.4.1",
    "https-browserify": "^1.0.0",
    "mini-css-extract-plugin": "^0.11.0",
    "minimatch": "^10.0.3",
    "postcss": "^8.5.6",
    "postcss-loader": "^4.3.0",
    "process": "^0.11.10",
    "raw-loader": "^0.5.1",
    "regenerator-runtime": "^0.13.9",
    "sass": "^1.89.2",
    "sass-loader": "^7.3.1",
    "style-loader": "^1.2.1",
    "to-string-loader": "^1.2.0",
    "vue-loader": "^17.0.0",
    "webpack": "^4.44.1",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.0"
  }
}
